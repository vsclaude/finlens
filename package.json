{
  "name": "finlens",
  "productName": "FinLens",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-electron.mjs --minify && vite build",
    "package": "bun run build && electron-builder",
    "rename": "node scripts/rename.mjs",
    "test": "node scripts/test.mjs",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "//dependencies": "Only what the packaged app loads at runtime. The renderer is bundled by Vite and the main process by esbuild, so almost everything belongs in devDependencies. A package goes here only when it must stay a real file in node_modules — a native module, say — and is then listed in `external` in scripts/build-electron.mjs.",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.299"
  },
  "devDependencies": {
    "@base-ui/react": "^1.6.0",
    "@eslint/js": "^9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.27.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.1.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20"
  },
  "//trustedDependencies": "bun does not run postinstall scripts unless a package is listed here; electron's is what downloads its binary.",
  "trustedDependencies": [
    "electron"
  ],
  "build": {
    "appId": "com.example.finlens",
    "productName": "FinLens",
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "resources/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "FinLens-${version}-${arch}.${ext}",
      "notarize": false
    },
    "win": {
      "icon": "resources/icon.png",
      "target": "nsis",
      "artifactName": "FinLens-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "target": "AppImage",
      "category": "Utility",
      "artifactName": "FinLens-${version}-${arch}.${ext}"
    },
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ]
  }
}
