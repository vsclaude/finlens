# dependencies
node_modules

# testing
coverage

# build output: the main process' bundle, the renderer's, the installers
dist
dist-electron
dist-renderer
release

# local bun cache/tmp overrides
.bun-cache
.bun-tmp

# misc
.DS_Store
*.pem

# scratch files: a repro, a one-off preview, a snippet kept beside the code it
# is about. The suffix is the marker, so they can live next to their subject
# without being committed.
*.local.*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# typescript
*.tsbuildinfo
