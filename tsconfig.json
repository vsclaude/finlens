{
  // The halves are typechecked separately — see `tsconfig.main.json`,
  // `tsconfig.renderer.json` and `tsconfig.test.json`, which `bun run
  // typecheck` runs in turn. This file exists so an editor, and the shadcn CLI
  // resolving the aliases in `components.json`, both find the path mapping
  // without having to guess which of them to open.
  "extends": "./tsconfig.base.json",
  "include": ["src", "test", "scripts", "vite.config.ts"]
}
